# 上下文压缩落盘副产物（进程退出后保留，不纳入版本控制）
.codeforge/sessions/

# 运行时自动生成的记忆文件
.codeforge/memory/

# 本地 Claude Code 设置
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.idea/
.ruff_cache/

# 打包产物
build/
dist/
*.egg-info/

# 环境变量与密钥（若改用 .env 存放）
.env
.env.*

# 本地配置（含 api_key，绝不提交）
config.yaml

# 日志
*.log

# 操作系统文件
.DS_Store
Thumbs.db

# 非功能性的 Markdown 文档（只保留 .codeforge/skills/*/SKILL.md）
CLAUDE.md
docs/

# 测试报告产物（pytest --junit-xml）
.junit_*.xml

# 验证/分析证据产物（对比图、报告等，非产品代码）
outputs/

# 本地 agent 会话数据与一次性脚本（含本机路径与临时排查文件）
.workbuddy-ai/

# 个人文档与观测数据导出（不属产品代码）
interview_prep.md
project_experience.md
pg_*.json
